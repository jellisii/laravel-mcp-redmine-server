APP_NAME="Redmine MCP Server"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array

# MCP Authentication
MCP_AUTH_TOKEN=

# Redmine Integration
REDMINE_BASE_URL=https://your-redmine.example.com
# API key auth (find it at https://your-redmine.example.com/my/account)
REDMINE_API_KEY=

# Alternative: Basic Auth (use instead of REDMINE_API_KEY)
# REDMINE_USERNAME=
# REDMINE_PASSWORD=

# REDMINE_DEFAULT_USER_ID=
